# ==========================================================================
# Exemplo de variáveis de ambiente — copie para .env e preencha.
# O arquivo .env NUNCA deve ser commitado (ver .gitignore).
# ==========================================================================

# --- Backend (copie para backend/.env) ---
# Chave da API do Google Gemini (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=sua_chave_aqui
# Modelo Gemini utilizado
GEMINI_MODEL=gemini-3.5-flash-lite
# Porta do servidor HTTP
PORT=3000
# Origens permitidas para CORS (separadas por vírgula). Use * em dev.
CORS_ORIGIN=http://localhost:5173
# Nível de log do Fastify: fatal | error | warn | info | debug | trace
LOG_LEVEL=info
# Resiliência da chamada à IA
IA_TENTATIVAS=3
IA_ATRASO_BASE_MS=800
# Busca na web (Google Search grounding) — cai para o RAG se indisponível
USAR_BUSCA_WEB=true
# RAG (base de conhecimento de hardware)
RAG_HABILITADO=true
RAG_TOP_K=4
EMBED_MODEL=gemini-embedding-001
# Versão reportada em GET /saude
APP_VERSION=1.0.0

# --- Frontend (copie para frontend/.env) ---
# URL base da API do backend (sem barra no final)
VITE_API_URL=http://localhost:3000
