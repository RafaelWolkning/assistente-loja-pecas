# --- Backend ---
# Chave da API do Google Gemini (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=sua_chave_aqui

# Modelo Gemini utilizado
GEMINI_MODEL=gemini-3.5-flash-lite

# Porta do servidor HTTP
PORT=3000

# Origens permitidas para CORS, separadas por vírgula.
# Em produção, informe a URL do frontend (ex.: https://seu-front.vercel.app).
# Use * apenas em desenvolvimento.
CORS_ORIGIN=http://localhost:5173

# Nível de log do Fastify: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Resiliência da chamada à IA (retentativas com backoff exponencial)
IA_TENTATIVAS=3
IA_ATRASO_BASE_MS=800

# Busca na web (Google Search grounding). Se falhar (ex.: cota), a aplicação
# continua respondendo com o conhecimento do RAG.
USAR_BUSCA_WEB=true

# RAG (base de conhecimento de hardware)
RAG_HABILITADO=true
RAG_TOP_K=4
EMBED_MODEL=gemini-embedding-001

# Versão reportada em GET /saude
APP_VERSION=1.0.0
